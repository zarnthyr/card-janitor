{
  "policies": [
    {
      "id": "5b19450f-4741-5ae2-8b8c-f5f62b87895e",
      "name": "Dev — Old Reviews",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Source",
            "include_subdecks": true
          }
        ]
      },
      "match": "all",
      "conditions": [
        {
          "type": "age",
          "days": 365,
          "source": "first_review",
          "operator": "gte"
        }
      ],
      "actions": [
        {
          "type": "add_tags",
          "tags": [
            "cj_test_old"
          ]
        },
        {
          "type": "suspend"
        }
      ]
    },
    {
      "id": "a6e138ed-1f9a-5c6b-afe2-824f64baaa49",
      "name": "Dev — Long Intervals",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Source",
            "include_subdecks": true
          }
        ]
      },
      "match": "all",
      "conditions": [
        {
          "type": "interval",
          "days": 365,
          "operator": "gte"
        }
      ],
      "actions": [
        {
          "type": "move",
          "deck": "Card Janitor Retired"
        }
      ]
    },
    {
      "id": "063e610d-e7bb-5e32-bcca-b00522b4cc8c",
      "name": "Dev — Never Studied",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Source",
            "include_subdecks": true
          }
        ]
      },
      "match": "all",
      "conditions": [
        {
          "type": "age",
          "days": 0,
          "source": "card_created",
          "operator": "gte"
        },
        {
          "type": "review_history",
          "operator": "not_exists"
        }
      ],
      "actions": [
        {
          "type": "add_tags",
          "tags": [
            "cj_test_never_studied"
          ]
        }
      ]
    },
    {
      "id": "8ac28569-390c-5f52-b32f-428ef2dcba61",
      "name": "Dev — Learning States",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Source",
            "include_subdecks": true
          }
        ]
      },
      "match": "all",
      "conditions": [
        {
          "type": "card_state",
          "states": [
            "learning",
            "relearning"
          ]
        }
      ],
      "actions": [
        {
          "type": "add_tags",
          "tags": [
            "cj_test_learning"
          ]
        }
      ]
    },
    {
      "id": "1067e16f-853c-5ad0-8d98-4bb2b1ac1204",
      "name": "Dev — Repair Suspended Leech",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Tag Actions",
            "include_subdecks": false
          }
        ]
      },
      "match": "all",
      "conditions": [
        {
          "type": "tags",
          "operator": "contains_all",
          "tags": [
            "leech",
            "cj_test_remove"
          ]
        },
        {
          "type": "suspension",
          "operator": "is_suspended"
        }
      ],
      "actions": [
        {
          "type": "remove_tags",
          "tags": [
            "leech",
            "cj_test_remove"
          ]
        },
        {
          "type": "unsuspend"
        }
      ]
    },
    {
      "id": "90a23866-98bd-510f-885f-9ec5925d7566",
      "name": "Dev — Replace All Tags",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Tag Actions",
            "include_subdecks": false
          }
        ]
      },
      "match": "all",
      "conditions": [
        {
          "type": "tags",
          "operator": "contains_any",
          "tags": [
            "cj_test_replace"
          ]
        },
        {
          "type": "suspension",
          "operator": "is_not_suspended"
        }
      ],
      "actions": [
        {
          "type": "replace_tags",
          "tags": [
            "card_janitor_test_fixture",
            "cj_test_replaced"
          ]
        }
      ]
    },
    {
      "id": "4130e98d-fb93-59ee-a659-4f6aef968db9",
      "name": "Dev — Delete Note",
      "scope": {
        "decks": [
          {
            "deck": "Card Janitor Test::Delete",
            "include_subdecks": false
          }
        ]
      },
      "actions": [
        {
          "type": "delete_note"
        }
      ]
    },
    {
      "id": "cfbf3bae-08fe-5846-9265-cdfdc40d78e2",
      "name": "Dev — Suspend Note",
      "scope": {
        "decks": [{"deck": "Card Janitor Test::Note Actions", "include_subdecks": false}],
        "note_types": [{"name": "Card Janitor Test Siblings"}]
      },
      "match": "all",
      "conditions": [
        {"type": "tags", "operator": "contains_all", "tags": ["cj_test_note_suspend"]},
        {"type": "sibling_suspension", "operator": "any"},
        {"type": "sibling_review_history", "operator": "none"}
      ],
      "actions": [{"type": "suspend_note"}]
    },
    {
      "id": "bf15ede9-aeaf-5170-be11-25be33b841d6",
      "name": "Dev — Unsuspend Note",
      "scope": {
        "decks": [{"deck": "Card Janitor Test::Note Actions", "include_subdecks": false}],
        "note_types": [{"name": "Card Janitor Test Siblings"}]
      },
      "match": "all",
      "conditions": [
        {"type": "tags", "operator": "contains_all", "tags": ["cj_test_note_unsuspend"]},
        {"type": "sibling_suspension", "operator": "any"}
      ],
      "actions": [{"type": "unsuspend_note"}]
    },
    {
      "id": "db81d9ff-1341-5707-b054-c05574af8aca",
      "name": "Dev — Move Note",
      "scope": {
        "decks": [{"deck": "Card Janitor Test::Note Actions", "include_subdecks": false}],
        "note_types": [{"name": "Card Janitor Test Siblings"}]
      },
      "match": "all",
      "conditions": [
        {"type": "tags", "operator": "contains_all", "tags": ["cj_test_note_move"]},
        {"type": "sibling_suspension", "operator": "none"},
        {"type": "sibling_review_history", "operator": "none"}
      ],
      "actions": [{"type": "move_note", "deck": "Card Janitor Test::Note Actions"}]
    }
  ]
}
