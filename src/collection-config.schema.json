{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "scope", "match", "conditions", "actions"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "mode": {
          "enum": ["on_demand", "automatic"],
          "description": "on_demand runs only when requested in Card Janitor; automatic also runs once per day without confirmation"
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Decks whose cards this policy may clean up"
        },
        "match": {
          "enum": ["all", "any"],
          "description": "Whether all conditions or any condition must match"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "description": "Conditions cards must satisfy before actions are applied",
          "items": {"$ref": "#/$defs/condition"}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "description": "Changes to apply when cards match",
          "items": {"$ref": "#/$defs/action"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actions": {
                "contains": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {"type": {"enum": ["delete_card", "delete_note"]}}
                }
              }
            }
          },
          "then": {"properties": {"actions": {"maxItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "conditions": {
                "contains": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {"type": {"const": "all_cards"}}
                }
              }
            }
          },
          "then": {"properties": {"conditions": {"maxItems": 1}}}
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["decks"], "not": {"required": ["all_decks"]}},
        {"required": ["all_decks"], "not": {"required": ["decks"]}}
      ],
      "properties": {
        "all_decks": {
          "const": true,
          "description": "Include all current and future non-filtered decks"
        },
        "decks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Union of per-deck exact or recursive selectors",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deck", "include_subdecks"],
            "properties": {
              "deck": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "include_subdecks": {"type": "boolean"}
            }
          }
        },
        "include_suspended": {
          "type": "boolean",
          "description": "Allow the policy to match cards that are already suspended"
        },
        "note_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "description": "Restrict scope to these note-type names; omit to include all current and future note types"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "all_cards"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "source", "operator"],
          "properties": {
            "type": {"const": "age"},
            "days": {"type": "integer", "minimum": 0, "maximum": 100000},
            "source": {"enum": ["first_review", "card_created"]},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "operator"],
          "properties": {
            "type": {"const": "interval"},
            "days": {"type": "integer", "minimum": 0, "maximum": 100000},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "states"],
          "properties": {
            "type": {"const": "card_state"},
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["new", "learning", "review", "relearning"]}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"const": "review_history"},
            "operator": {"enum": ["exists", "not_exists"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags", "operator"],
          "properties": {
            "type": {"const": "tags"},
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^\\s*[^\\s,]+\\s*$"}
            },
            "operator": {"enum": ["contains_any", "contains_all", "contains_none"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"const": "suspension"},
            "operator": {"enum": ["is_suspended", "is_not_suspended"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"enum": ["sibling_suspension", "sibling_review_history"]},
            "operator": {"enum": ["all", "any", "none"]}
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags"],
          "properties": {
            "type": {"enum": ["tag", "add_tags", "remove_tags"]},
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^\\s*[^\\s,]+\\s*$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags"],
          "properties": {
            "type": {"const": "replace_tags"},
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^\\s*[^\\s,]+\\s*$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["suspend", "unsuspend", "suspend_note", "unsuspend_note", "delete_card", "delete_note"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "deck"],
          "properties": {
            "type": {"enum": ["move", "move_note"]},
            "deck": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      ]
    }
  }
}
