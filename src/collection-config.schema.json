{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actions"],
      "dependentRequired": {
        "match": ["conditions"],
        "conditions": ["match"]
      },
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Automatic events. Omit for a manual-only policy; all policies remain manually runnable.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {"type": {"enum": ["daily", "on_open", "on_sync"]}}
          }
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Optional deck and note/card-type restrictions; omit for unrestricted scope"
        },
        "match": {
          "enum": ["all", "any"],
          "description": "Whether all conditions or any condition must match"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "description": "Conditions cards must satisfy before actions are applied",
          "items": {"$ref": "#/$defs/condition"}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "description": "Changes to apply when cards match",
          "items": {"$ref": "#/$defs/action"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actions": {
                "contains": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {"type": {"enum": ["delete_card", "delete_note"]}}
                }
              }
            }
          },
          "then": {"properties": {"actions": {"maxItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "actions": {
                "contains": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {"type": {"enum": ["delete_card", "delete_note"]}}
                }
              }
            }
          },
          "then": {
            "anyOf": [
              {"required": ["scope"]},
              {"required": ["conditions"]}
            ]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "anyOf": [
        {"required": ["decks"]},
        {"required": ["note_types"]}
      ],
      "properties": {
        "decks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Union of per-deck exact or recursive selectors",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deck", "include_subdecks"],
            "properties": {
              "deck": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "include_subdecks": {"type": "boolean"}
            }
          }
        },
        "note_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/note_type_selector"},
          "description": "Restrict scope to these note types and optionally their card types; omit to include all current and future note types"
        }
      }
    },
    "note_type_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "card_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "description": "Exact card types to include; omit to include all current and future card types"
        }
      }
    },
    "condition": {
      "oneOf": [
        {"$ref": "#/$defs/simple_condition"},
        {"$ref": "#/$defs/condition_group"}
      ]
    },
    "condition_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "conditions"],
      "properties": {
        "match": {"enum": ["all", "any"]},
        "conditions": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/simple_condition"}
        }
      }
    },
    "simple_condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "source", "operator"],
          "properties": {
            "type": {"const": "age"},
            "days": {"type": "integer", "minimum": 0, "maximum": 100000},
            "source": {"enum": ["first_review", "last_review", "card_created"]},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "operator"],
          "properties": {
            "type": {"const": "interval"},
            "days": {"type": "integer", "minimum": 0, "maximum": 100000},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "states"],
          "properties": {
            "type": {"const": "card_state"},
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["new", "learning", "review", "relearning"]}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "flags"],
          "properties": {
            "type": {"const": "card_flag"},
            "flags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["none", "red", "orange", "green", "blue", "pink", "turquoise", "purple"]}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "count", "operator"],
          "properties": {
            "type": {"enum": ["answer_count", "correct_answer_count", "lapse_count"]},
            "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "percent", "operator"],
          "properties": {
            "type": {"const": "correct_answer_rate"},
            "percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "operator"],
          "properties": {
            "type": {"const": "overdue"},
            "days": {"type": "integer", "minimum": 0, "maximum": 100000},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "operator"],
          "properties": {
            "type": {"const": "fsrs_stability"},
            "days": {"type": "integer", "minimum": 0, "maximum": 100000},
            "operator": {"enum": ["gt", "gte", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "percent", "operator"],
          "properties": {
            "type": {"enum": ["fsrs_difficulty", "fsrs_retrievability"]},
            "percent": {"type": "integer", "minimum": 0, "maximum": 100},
            "operator": {"enum": ["gt", "gte", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "percent", "operator"],
          "properties": {
            "type": {"const": "sm2_ease"},
            "percent": {"type": "integer", "minimum": 0, "maximum": 1000},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"const": "review_history"},
            "operator": {"enum": ["exists", "not_exists"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags", "operator"],
          "properties": {
            "type": {"const": "tags"},
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^\\s*[^\\s,]+\\s*$"}
            },
            "operator": {"enum": ["contains_any", "contains_all", "contains_none"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"const": "suspension"},
            "operator": {"enum": ["is_suspended", "is_not_suspended"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"enum": ["sibling_suspension", "sibling_review_history"]},
            "operator": {"enum": ["all", "any", "none"]}
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags"],
          "properties": {
            "type": {"enum": ["add_tags", "remove_tags"]},
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^\\s*[^\\s,]+\\s*$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags"],
          "properties": {
            "type": {"const": "replace_tags"},
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^\\s*[^\\s,]+\\s*$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["suspend", "unsuspend", "suspend_note", "unsuspend_note", "delete_card", "delete_note"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "deck"],
          "properties": {
            "type": {"enum": ["move", "move_note"]},
            "deck": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "flag"],
          "properties": {
            "type": {"const": "set_flag"},
            "flag": {"enum": ["red", "orange", "green", "blue", "pink", "turquoise", "purple"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"const": "clear_flag"}
          }
        }
      ]
    }
  }
}
