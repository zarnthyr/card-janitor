{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "notify_after_automatic_run",
    "debug_logging",
    "policies"
  ],
  "properties": {
    "config_version": {
      "const": 1
    },
    "notify_after_automatic_run": {
      "type": "boolean",
      "description": "Show a summary when cards are cleaned up automatically"
    },
    "debug_logging": {
      "type": "boolean",
      "description": "Print policy evaluation diagnostics to the terminal"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mode", "scope", "match", "conditions", "actions"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "mode": {
          "enum": ["on_demand", "automatic"],
          "description": "on_demand runs only when requested in Card Janitor; automatic also runs once per day without confirmation"
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Decks whose cards this policy may clean up"
        },
        "match": {
          "enum": ["all", "any"],
          "description": "Whether all conditions or any condition must match"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "description": "Conditions cards must satisfy before actions are applied",
          "items": {"$ref": "#/$defs/condition"}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "description": "Changes to apply to matching cards",
          "items": {"$ref": "#/$defs/action"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "actions": {
                "contains": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {"type": {"const": "delete_card"}}
                }
              }
            }
          },
          "then": {"properties": {"actions": {"maxItems": 1}}}
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decks"],
      "properties": {
        "decks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Exact names of one or more existing decks",
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "include_subdecks": {
          "type": "boolean",
          "description": "Also include every child deck of each named deck"
        },
        "include_suspended": {
          "type": "boolean",
          "description": "Allow the policy to match cards that are already suspended"
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "source", "operator"],
          "properties": {
            "type": {"const": "age"},
            "days": {"type": "integer", "minimum": 0},
            "source": {"enum": ["first_review", "card_created"]},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "operator"],
          "properties": {
            "type": {"const": "interval"},
            "days": {"type": "integer", "minimum": 0},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "states"],
          "properties": {
            "type": {"const": "card_state"},
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["new", "learning", "review", "relearning"]}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"const": "review_history"},
            "operator": {"enum": ["exists", "not_exists"]}
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tags"],
          "properties": {
            "type": {"const": "tag"},
            "tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["suspend", "delete_card"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "deck"],
          "properties": {
            "type": {"const": "move"},
            "deck": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        }
      ]
    }
  }
}
