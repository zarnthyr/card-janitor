{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "notify_after_automatic_run",
    "debug_logging",
    "policies"
  ],
  "properties": {
    "config_version": {
      "const": 1
    },
    "notify_after_automatic_run": {
      "type": "boolean",
      "description": "Show a summary when cards are cleaned up automatically"
    },
    "debug_logging": {
      "type": "boolean",
      "description": "Print policy evaluation diagnostics to the terminal"
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "state", "scope", "rule", "actions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "state": {
          "enum": ["on_demand", "automatic"],
          "description": "on_demand runs only when requested in Card Janitor; automatic also runs once per day without confirmation"
        },
        "scope": {
          "$ref": "#/$defs/scope",
          "description": "Decks whose cards this policy may clean up"
        },
        "rule": {
          "$ref": "#/$defs/rule",
          "description": "Condition or flat AND/OR group that cards must match"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "description": "Changes to apply to matching cards",
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decks"],
      "properties": {
        "decks": {
          "type": "array",
          "minItems": 1,
          "description": "Exact names of one or more existing decks",
          "items": {"type": "string", "minLength": 1}
        },
        "include_subdecks": {
          "type": "boolean",
          "description": "Also include every child deck of each named deck"
        },
        "include_suspended": {
          "type": "boolean",
          "description": "Allow the policy to match cards that are already suspended"
        }
      }
    },
    "rule": {
      "oneOf": [
        {"$ref": "#/$defs/simple_rule"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rules"],
          "properties": {
            "type": {"enum": ["all", "any"]},
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/simple_rule"}
            }
          }
        }
      ]
    },
    "simple_rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "from", "operator"],
          "properties": {
            "type": {"const": "age"},
            "days": {"type": "integer", "minimum": 0},
            "from": {"enum": ["first_review", "card_created"]},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "days", "operator"],
          "properties": {
            "type": {"const": "interval"},
            "days": {"type": "integer", "minimum": 0},
            "operator": {"enum": ["gt", "gte", "eq", "lte", "lt"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "states"],
          "properties": {
            "type": {"const": "card_state"},
            "states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["new", "learning", "review", "relearning"]}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operator"],
          "properties": {
            "type": {"const": "review_history"},
            "operator": {"enum": ["exists", "not_exists"]}
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tag"],
          "properties": {
            "type": {"const": "tag"},
            "tag": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"enum": ["suspend", "delete_card"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "deck"],
          "properties": {
            "type": {"const": "move"},
            "deck": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
